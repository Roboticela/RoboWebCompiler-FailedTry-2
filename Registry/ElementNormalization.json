    { "source": "textarea", "kind": "TextArea", "formAssociated": true },
    { "source": "select", "kind": "Select", "formAssociated": true, "interactive": true },
    { "source": "option", "kind": "Option" },
    { "source": "optgroup", "kind": "OptionGroup" },
    { "source": "datalist", "kind": "DataList" },
    { "source": "selectedcontent", "kind": "SelectedContent" },
    { "source": "output", "kind": "Output", "formAssociated": true },
    { "source": "progress", "kind": "Progress", "formAssociated": true },

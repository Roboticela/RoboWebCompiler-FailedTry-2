    { "source": "applet", "kind": "ObsoleteElement", "obsolete": true },
    { "source": "basefont", "kind": "ObsoleteElement", "obsolete": true },
    { "source": "bgsound", "kind": "ObsoleteElement", "obsolete": true },
    { "source": "big", "kind": "ObsoleteElement", "obsolete": true },
    { "source": "blink", "kind": "ObsoleteElement", "obsolete": true },
    { "source": "center", "kind": "ObsoleteElement", "obsolete": true },
    { "source": "dir", "kind": "ObsoleteElement", "obsolete": true },
    { "source": "font", "kind": "ObsoleteElement", "obsolete": true },
    { "source": "frame", "kind": "ObsoleteElement", "obsolete": true },
    { "source": "frameset", "kind": "ObsoleteElement", "obsolete": true },
    { "source": "isindex", "kind": "ObsoleteElement", "obsolete": true },
    { "source": "keygen", "kind": "ObsoleteElement", "obsolete": true },

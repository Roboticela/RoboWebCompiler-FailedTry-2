{
  "$schema": "RoboHTMLCompiler.ElementNormalization.v1",
  "namespace": "HTML",
  "description": "Maps each HTML source element recognised by the reference vocabulary onto one compact native category. Many source elements intentionally share a category; the original source tag is still preserved on the native node for the web target and for debugging.",

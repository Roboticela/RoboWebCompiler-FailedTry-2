    { "source": "noframes", "kind": "ObsoleteElement", "obsolete": true },
    { "source": "plaintext", "kind": "ObsoleteElement", "obsolete": true },
    { "source": "rb", "kind": "ObsoleteElement", "obsolete": true },
    { "source": "rtc", "kind": "ObsoleteElement", "obsolete": true },
    { "source": "spacer", "kind": "ObsoleteElement", "obsolete": true },
    { "source": "strike", "kind": "ObsoleteElement", "obsolete": true },
    { "source": "tt", "kind": "ObsoleteElement", "obsolete": true },
    { "source": "xmp", "kind": "ObsoleteElement", "obsolete": true }
  ]
}

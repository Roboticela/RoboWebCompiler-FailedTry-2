    { "source": "html", "kind": "Document" },
    { "source": "head", "kind": "Metadata" },
    { "source": "title", "kind": "DocumentTitle" },
    { "source": "base", "kind": "BaseUrl", "void": true },
    { "source": "link", "kind": "ResourceLink", "void": true },
    { "source": "meta", "kind": "Metadata", "void": true },
    { "source": "style", "kind": "StyleSheet", "rawText": true },
    { "source": "script", "kind": "ScriptResource", "rawText": true },
    { "source": "noscript", "kind": "NoScript" },
    { "source": "body", "kind": "Container" },

    { "source": "address", "kind": "Container" },
    { "source": "article", "kind": "Container" },
    { "source": "aside", "kind": "Container" },
    { "source": "footer", "kind": "Container" },
    { "source": "header", "kind": "Container" },
    { "source": "main", "kind": "Container" },
    { "source": "nav", "kind": "Container" },
    { "source": "section", "kind": "Container" },

    { "source": "small", "kind": "Text", "phrasing": true },
    { "source": "span", "kind": "Text", "phrasing": true },
    { "source": "strong", "kind": "Text", "phrasing": true },
    { "source": "sub", "kind": "Text", "phrasing": true },
    { "source": "sup", "kind": "Text", "phrasing": true },
    { "source": "time", "kind": "Text", "phrasing": true },

{
  "$schema": "RoboHTMLCompiler.AttributeSemantics.v1",
  "description": "Classifies attributes as compile-time constants or runtime-mutable state so the native representation can be optimised: compile-time attributes are folded into the native node, runtime-mutable ones stay addressable.",
  "runtimeMutable": [
    "value",
    "checked",
    "selected",
    "indeterminate",
    "disabled",
    "hidden",
    "open",
    "readonly",
    "required",
    "inert",
    "src",
    "href",
    "srcset",
    "poster",
    "autoplay",
    "muted",
    "loop",
    "controls",
    "aria-hidden",
    "aria-expanded",
    "aria-checked",
    "aria-selected",
    "aria-pressed",
    "aria-disabled",
    "aria-busy",
    "aria-invalid",
    "aria-live",
    "aria-current",
    "aria-valuenow",
    "aria-valuetext"
  ],
  "notBrowserPreserved": [],
  "notCompileTime": [
    "value",
    "checked",
    "selected",
    "indeterminate",
    "aria-busy"
  ]
}

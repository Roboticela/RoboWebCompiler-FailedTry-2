    { "name": "aria-sort", "property": "AccessibilitySort", "valueType": "Token", "values": ["ascending", "descending", "none", "other"] },
    { "name": "aria-valuemax", "property": "AccessibilityValueMaximum", "valueType": "Number" },
    { "name": "aria-valuemin", "property": "AccessibilityValueMinimum", "valueType": "Number" },
    { "name": "aria-valuenow", "property": "AccessibilityValueNow", "valueType": "Number" },
    { "name": "aria-valuetext", "property": "AccessibilityValueText", "valueType": "String" }

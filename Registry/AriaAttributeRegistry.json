    { "name": "aria-keyshortcuts", "property": "AccessibilityKeyShortcuts", "valueType": "String" },
    { "name": "aria-label", "property": "AccessibilityLabel", "valueType": "String" },
    { "name": "aria-labelledby", "property": "AccessibilityLabelledBy", "valueType": "IdReferenceList" },
    { "name": "aria-level", "property": "AccessibilityLevel", "valueType": "Integer" },
    { "name": "aria-live", "property": "AccessibilityLive", "valueType": "Token", "values": ["assertive", "off", "polite"] },
    { "name": "aria-modal", "property": "AccessibilityModal", "valueType": "Boolean" },

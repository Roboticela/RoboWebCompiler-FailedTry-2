    { "name": "aria-colcount", "property": "AccessibilityColumnCount", "valueType": "Integer" },
    { "name": "aria-colindex", "property": "AccessibilityColumnIndex", "valueType": "Integer" },
    { "name": "aria-colindextext", "property": "AccessibilityColumnIndexText", "valueType": "String" },
    { "name": "aria-colspan", "property": "AccessibilityColumnSpan", "valueType": "Integer" },

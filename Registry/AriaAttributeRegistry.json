    { "name": "aria-errormessage", "property": "AccessibilityErrorMessage", "valueType": "IdReference" },
    { "name": "aria-expanded", "property": "AccessibilityExpanded", "valueType": "Tristate", "values": ["true", "false", "undefined"] },
    { "name": "aria-flowto", "property": "AccessibilityFlowTo", "valueType": "IdReferenceList" },

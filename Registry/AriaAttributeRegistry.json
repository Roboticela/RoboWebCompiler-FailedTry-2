    { "name": "aria-posinset", "property": "AccessibilityPositionInSet", "valueType": "Integer" },
    { "name": "aria-pressed", "property": "AccessibilityPressed", "valueType": "Tristate", "values": ["true", "false", "mixed", "undefined"] },
    { "name": "aria-readonly", "property": "AccessibilityReadOnly", "valueType": "Boolean" },
    { "name": "aria-relevant", "property": "AccessibilityRelevant", "valueType": "TokenList", "values": ["additions", "all", "removals", "text"] },
    { "name": "aria-required", "property": "AccessibilityRequired", "valueType": "Boolean" },
    { "name": "aria-roledescription", "property": "AccessibilityRoleDescription", "valueType": "String" },
    { "name": "aria-rowcount", "property": "AccessibilityRowCount", "valueType": "Integer" },

{
  "$schema": "RoboHTMLCompiler.AttributeRouting.v1",
  "namespace": "HTML",
  "description": "Typed routing table for every registered HTML attribute. Entries with an 'elements' list apply only to those source elements; an entry without one is the default route. This is what keeps the hot-path native representation strongly typed instead of an attribute dictionary.",
  "routes": [
    { "attribute": "id", "property": "IdentityId" },
    { "attribute": "name", "property": "IdentityName" },
    { "attribute": "class", "property": "StyleReference" },
    { "attribute": "slot", "property": "SlotAssignment" },
    { "attribute": "style", "property": "ForbiddenInlineStyle", "forbidden": true },

    { "attribute": "hidden", "property": "StateHidden" },
    { "attribute": "disabled", "property": "StateDisabled" },
    { "attribute": "checked", "property": "StateChecked" },
    { "attribute": "selected", "property": "StateSelected" },
    { "attribute": "readonly", "property": "StateReadOnly" },
    { "attribute": "required", "property": "StateRequired" },
    { "attribute": "inert", "property": "StateInert" },
    { "attribute": "open", "property": "StateOpen" },
    { "attribute": "multiple", "property": "StateMultiple" },
    { "attribute": "autofocus", "property": "StateAutofocus" },
    { "attribute": "draggable", "property": "StateDraggable" },
    { "attribute": "spellcheck", "property": "StateSpellCheck" },
    { "attribute": "loading", "property": "ResourceLoadMode" },

    { "attribute": "tabindex", "property": "InteractionTabIndex" },
    { "attribute": "popovertarget", "property": "InteractionCommandTarget" },
    { "attribute": "popovertargetaction", "property": "InteractionCommand" },
    { "attribute": "command", "property": "InteractionCommand" },
    { "attribute": "commandfor", "property": "InteractionCommandFor" },
    { "attribute": "for", "property": "LabelFor" },

    { "attribute": "accesskey", "property": "MetadataAccessKey" },
    { "attribute": "nonce", "property": "MetadataNonce" },
    { "attribute": "popover", "property": "MetadataPopover" },
    { "attribute": "contenteditable", "property": "MetadataEditable" },
    { "attribute": "inputmode", "property": "MetadataInputMode" },
    { "attribute": "enterkeyhint", "property": "MetadataEnterKeyHint" },
    { "attribute": "autocapitalize", "property": "MetadataAutoCapitalize" },
    { "attribute": "autocorrect", "property": "MetadataAutoCorrect" },
    { "attribute": "writingsuggestions", "property": "MetadataWriteSuggestions" },
    { "attribute": "headingoffset", "property": "HeadingOffset" },
    { "attribute": "headingreset", "property": "HeadingReset" },

    { "attribute": "lang", "property": "TextLanguage" },
    { "attribute": "dir", "property": "TextDirection" },
    { "attribute": "translate", "property": "TextTranslate" },
    { "attribute": "title", "property": "MetadataTitle" },

    { "attribute": "is", "property": "CustomizedBuiltIn" },
    { "attribute": "itemid", "property": "MicroDataItemId" },
    { "attribute": "itemprop", "property": "MicroDataItemProp" },
    { "attribute": "itemref", "property": "MicroDataItemRef" },
    { "attribute": "itemscope", "property": "MicroDataItemScope" },
    { "attribute": "itemtype", "property": "MicroDataItemType" },

    { "attribute": "href", "property": "NavigationHref" },
    { "attribute": "target", "property": "NavigationTarget" },
    { "attribute": "download", "property": "NavigationDownload" },
    { "attribute": "rel", "property": "NavigationRelation" },
    { "attribute": "hreflang", "property": "NavigationLanguage" },
    { "attribute": "ping", "property": "NavigationPing" },
    { "attribute": "referrerpolicy", "property": "NavigationReferrerPolicy" },
    { "attribute": "type", "elements": ["input"], "property": "InputType" },
    { "attribute": "type", "elements": ["button"], "property": "ButtonType" },
    { "attribute": "type", "elements": ["ol"], "property": "ListStyle" },
    { "attribute": "type", "property": "ResourceMimeType" },

    { "attribute": "src", "property": "ResourceSource" },
    { "attribute": "srcset", "property": "ResourceSourceSet" },
    { "attribute": "sizes", "property": "ResourceSizes" },
    { "attribute": "imagesrcset", "property": "ResourceCandidates" },
    { "attribute": "imagesizes", "property": "ResourceImages" },
    { "attribute": "as", "property": "ResourceDestination" },
    { "attribute": "integrity", "property": "ResourceIntegrity" },
    { "attribute": "crossorigin", "property": "ResourceCrossOrigin" },
    { "attribute": "fetchpriority", "property": "ResourceFetchPriority" },
    { "attribute": "media", "property": "ResourceMedia" },
    { "attribute": "blocking", "property": "ResourceBlocking" },
    { "attribute": "decoding", "property": "ResourceDecoding" },
    { "attribute": "charset", "property": "DocumentCharacterSet" },
    { "attribute": "color", "property": "ResourceColor" },
    { "attribute": "href", "elements": ["link"], "property": "ResourceSource" },

    { "attribute": "alt", "property": "ImageAlternativeText" },
    { "attribute": "ismap", "property": "ImageMapServerSide" },
    { "attribute": "usemap", "property": "ImageMapName" },
    { "attribute": "shape", "property": "ImageMapShape" },
    { "attribute": "coords", "property": "ImageMapCoordinates" },

    { "attribute": "width", "elements": ["canvas", "embed", "iframe"], "property": "EmbeddedWidth" },
    { "attribute": "height", "elements": ["canvas", "embed", "iframe"], "property": "EmbeddedHeight" },
    { "attribute": "width", "property": "LayoutWidth" },
    { "attribute": "height", "property": "LayoutHeight" },
    { "attribute": "size", "property": "InputSize" },
    { "attribute": "span", "property": "LayoutSpan" },
    { "attribute": "cols", "property": "LayoutColumns" },
    { "attribute": "rows", "property": "LayoutRows" },
    { "attribute": "colspan", "property": "LayoutColumnSpan" },
    { "attribute": "rowspan", "property": "LayoutRowSpan" },
    { "attribute": "scope", "property": "LayoutScope" },
    { "attribute": "headers", "property": "LayoutHeaders" },
    { "attribute": "abbr", "property": "AccessibilityLabel" },

    { "attribute": "min", "property": "ConstraintMinimum" },
    { "attribute": "max", "property": "ConstraintMaximum" },
    { "attribute": "step", "property": "ConstraintStep" },
    { "attribute": "low", "property": "ConstraintLow" },
    { "attribute": "high", "property": "ConstraintHigh" },
    { "attribute": "optimum", "property": "ConstraintOptimum" },
    { "attribute": "pattern", "property": "ValidationPattern" },
    { "attribute": "minlength", "property": "ValidationMinimumLength" },
    { "attribute": "maxlength", "property": "ValidationMaximumLength" },
    { "attribute": "accept", "property": "ValidationAccept" },
    { "attribute": "formnovalidate", "property": "FormNoValidate" },
    { "attribute": "novalidate", "property": "FormNoValidate" },

    { "attribute": "autocomplete", "property": "InputAutocomplete" },
    { "attribute": "placeholder", "property": "InputPlaceholder" },
    { "attribute": "dirname", "property": "InputDirectoryName" },
    { "attribute": "list", "property": "InputOptions" },
    { "attribute": "wrap", "property": "InputWrap" },
    { "attribute": "value", "property": "ValueValue" },
    { "attribute": "default", "property": "ValueDefaultValue" },
    { "attribute": "label", "property": "OptionLabel" },
    { "attribute": "alpha", "property": "ColorAlpha" },
    { "attribute": "colorspace", "property": "ColorSpace" },

    { "attribute": "action", "property": "FormAction" },
    { "attribute": "formaction", "property": "FormAction" },
    { "attribute": "enctype", "property": "FormEnctype" },
    { "attribute": "formenctype", "property": "FormEnctype" },
    { "attribute": "accept-charset", "property": "DocumentCharacterSet" },
    { "attribute": "method", "property": "FormMethod" },
    { "attribute": "formmethod", "property": "FormMethod" },
    { "attribute": "formtarget", "property": "FormTarget" },
    { "attribute": "form", "property": "FormOwner" },

    { "attribute": "controls", "property": "MediaControls" },
    { "attribute": "autoplay", "property": "MediaAutoPlay" },
    { "attribute": "loop", "property": "MediaLoop" },
    { "attribute": "muted", "property": "MediaMuted" },
    { "attribute": "poster", "property": "MediaPoster" },
    { "attribute": "preload", "property": "MediaPreload" },
    { "attribute": "playsinline", "property": "MediaPlayInline" },
    { "attribute": "kind", "property": "MediaKind" },
    { "attribute": "srclang", "property": "MediaSourceLanguage" },
    { "attribute": "reversed", "property": "ListReversed" },
    { "attribute": "start", "property": "ListStart" },
    { "attribute": "cite", "property": "QuoteCitation" },
    { "attribute": "datetime", "property": "DateValue" },
    { "attribute": "closedby", "property": "DialogCloseBehavior" },

    { "attribute": "async", "property": "ScriptAsynchronous" },
    { "attribute": "defer", "property": "ScriptDeferred" },
    { "attribute": "nomodule", "property": "ScriptNoModule" },

    { "attribute": "allow", "property": "FramePermissions" },
    { "attribute": "allowfullscreen", "property": "FrameAllowFullScreen" },
    { "attribute": "sandbox", "property": "FrameSandbox" },
    { "attribute": "srcdoc", "property": "FrameSourceDocument" },

    { "attribute": "data", "property": "EmbeddedData" },

    { "attribute": "content", "property": "MetadataContent" },
    { "attribute": "http-equiv", "property": "DocumentHttpEquiv" },

    { "attribute": "shadowrootmode", "property": "ShadowRootMode" },
    { "attribute": "shadowrootdelegatesfocus", "property": "ShadowRootDelegatesFocus" },
    { "attribute": "shadowrootslotassignment", "property": "ShadowRootSlotAssignment" },
    { "attribute": "shadowrootclonable", "property": "ShadowRootClonable" },
    { "attribute": "shadowrootserializable", "property": "ShadowRootSerializable" },
    { "attribute": "shadowrootcustomelementregistry", "property": "ShadowRootCustomElementRegistry" }
  ]
}
